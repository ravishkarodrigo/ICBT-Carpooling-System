# ---- Shared / compose ----
JWT_SECRET=replace-with-a-long-random-string
# Use the in-memory store (no credentials needed) or set to false for Firestore.
USE_IN_MEMORY_DB=true

# ---- Firebase (only needed when USE_IN_MEMORY_DB=false) ----
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project-id.iam.gserviceaccount.com
# Keep the quotes and the \n escapes exactly as they appear in the service account JSON.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ---- Backend ----
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# ---- Frontend (Vite) ----
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
